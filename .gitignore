# .gitignore

# Environment variables and local configuration
.env
.env.*
!.env.example
!.env.*.example
appsettings.Local.json
appsettings.*.Local.json
local.settings.json
secrets.json

# Credentials and private certificates
*.key
*.pem
*.pfx
*.p12

# .NET build output
[Bb]in/
[Oo]bj/
artifacts/
.artifacts/
[Dd]ebug/
[Rr]elease/
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage*.xml
BenchmarkDotNet.Artifacts/
project.lock.json
project.fragment.lock.json
packages/
*.nupkg
*.snupkg

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Node.js dependencies
node_modules/
.pnpm-store/

# Angular build output and caches
dist/
out-tsc/
.angular/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.sass-cache/

# Frontend test output
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
cypress/screenshots/
cypress/videos/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Application logs
[Ll]og/
[Ll]ogs/
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Azure local state
.azure/

# Local infrastructure parameters
*.local.bicepparam
*.local.tfvars
.terraform/
*.tfstate
*.tfstate.*

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
~$*

# Operating-system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
